# Copy file này thành `.env` khi chạy Gateway local.
# Không commit `.env`, password Redis hoặc internal service token lên Git.
#
# Quy tắc theo môi trường:
# - Chạy trực tiếp trên máy: dùng localhost và port được expose ra host.
# - Docker Compose/Kubernetes: đổi localhost thành tên service/DNS nội bộ.
# - Production: inject secret từ Secret Manager/Kubernetes Secret, không ghi vào image.

# ============================================================================
# 01 · Runtime và HTTP API
# Gateway là cửa vào của frontend, nhận request rồi chuyển tiếp tới các service.
# ============================================================================

APP_VERSION=1.0.0                                      # Version hiển thị trong health response
NODE_ENV=development                                   # development | test | production
PORT=3001                                              # Cổng HTTP khi chạy Gateway trực tiếp trên máy

# ============================================================================
# 02 · CORS cho frontend và WebSocket
# Chỉ cho phép origin của web app; không dùng * khi credentials=true.
# ============================================================================

ALLOWED_ORIGINS=http://localhost:5173                    # Phân tách nhiều origin bằng dấu phẩy

# ============================================================================
# 03 · Xác thực JWT qua Keycloak
# Gateway dùng issuer/realm để lấy JWKS và kiểm tra chữ ký access token.
# KEYCLOAK_URL phải là URL mà API Gateway truy cập được, không nhất thiết là URL public.
# ============================================================================

KEYCLOAK_URL=http://localhost:8080                      # Docker/K8s: http://keycloak:8080
KEYCLOAK_REALM=bin-ecommerce                            # Realm phát hành access token

# ============================================================================
# 04 · Redis cho rate limit và realtime notification
# Dùng Redis giúp counter rate limit được chia sẻ khi Gateway chạy nhiều replica.
# ============================================================================

REDIS_HOST=localhost                                    # Docker/K8s: redis hoặc DNS Redis managed
REDIS_PORT=6379                                         # Cổng Redis
REDIS_PASSWORD=
REDIS_DB=0                                              # Database index dành cho Gateway

# ============================================================================
# 05 · Token gọi service nội bộ
# Token này được Gateway truyền qua request nội bộ tới các route được bảo vệ.
# Không dùng token này ở frontend hoặc commit giá trị thật vào repository.
# ============================================================================

INTERNAL_SERVICE_TOKEN=

# ============================================================================
# 06 · URL các downstream service
# Mỗi proxy controller đọc một URL tương ứng. Trong Docker/Kubernetes, dùng service
# name và container port; không dùng localhost vì localhost khi đó là chính Gateway.
# ============================================================================

AUTH_SERVICE_URL=http://localhost:3002                   # Đăng nhập, user và phân quyền
CATALOG_SERVICE_URL=http://localhost:3003                # Catalog/category proxy
MEDIA_SERVICE_URL=http://localhost:3004                  # Upload và quản lý media
NOTIFICATION_SERVICE_URL=http://localhost:3005           # Notification feed/action
RECOMMENDATION_SERVICE_URL=http://localhost:3006         # Recommendation và admin policy
SELLER_SERVICE_URL=http://localhost:3007                 # Seller, shop và seller settings
PRODUCT_SERVICE_URL=http://localhost:3008                # Product, review và seller product
AI_SERVICE_URL=http://localhost:3009                     # AI content/image optimization
CART_SERVICE_URL=http://localhost:3010                   # Cart API
ORDER_SERVICE_URL=http://localhost:3011                  # Customer/seller order API
SHIPPING_SERVICE_URL=http://localhost:3012               # Shipping, tracking và location
