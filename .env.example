# ============================================================
# API Gateway Environment
# ============================================================
# Scope:
# - Copy to services/api-gateway/.env for local standalone runs.
# - In production, inject these values only into api-gateway by
#   Secret Manager, Kubernetes Secret, ECS Task Definition, or CI/CD secrets.
# - The gateway should only receive routing, CORS, JWT verification, and
#   rate-limit storage config.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3001

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Keycloak JWT verification
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bin-ecommerce

# Redis - gateway rate limit storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Downstream service URLs
AUTH_SERVICE_URL=http://localhost:3002
MEDIA_SERVICE_URL=http://localhost:3004
CATALOG_SERVICE_URL=http://localhost:3003
LOCATION_SERVICE_URL=http://localhost:3006
SELLER_SERVICE_URL=http://localhost:3007
PRODUCT_SERVICE_URL=http://localhost:3008
AI_SERVICE_URL=http://localhost:3009
CART_SERVICE_URL=http://localhost:3010
ORDER_SERVICE_URL=http://localhost:3011
INVENTORY_SERVICE_URL=http://localhost:3011
NOTIFICATION_SERVICE_URL=http://localhost:3005
SHIPPING_SERVICE_URL=http://localhost:3012
PROMOTION_SERVICE_URL=http://localhost:3013
RETURN_SERVICE_URL=http://localhost:3014
